# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Database
POSTGRES_DB=mosobr_ai
POSTGRES_USER=mosobr
POSTGRES_PASSWORD=mosobr_password
DATABASE_URL=postgresql+psycopg://mosobr:mosobr_password@db:5432/mosobr_ai

# Ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# RAG
EMBEDDING_MODEL=BAAI/bge-m3
TOP_K=5

# Paths
DATA_PATH=/app/data/colleges.json
FAQ_PATH=/app/data/faq_admission.json
HF_HOME=/app/local_cache/huggingface
SENTENCE_TRANSFORMERS_HOME=/app/local_cache/sentence_transformers
LOGS_DIR=/app/logs

# App
LOG_LEVEL=INFO
SESSION_TTL_MINUTES=30
