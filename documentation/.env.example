# Documentation copy of the root .env.example.
# The main template is ../.env.example. Keep both files in sync if values change.

APP_NAME=MosObr AI
APP_ENV=dev
LOG_LEVEL=INFO

# Ollama runs outside the app container by default.
OLLAMA_HOST=http://localhost:11434
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# RAG embeddings.
EMBEDDING_MODEL=BAAI/bge-m3
HF_HUB_DISABLE_XET=1

# PostgreSQL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mosobr_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# Data.
DATA_PATH=./data/colleges.json
FAQ_DATA_PATH=./data/faq_admission.json
BOOTSTRAP_INGEST=auto

# Interfaces.
API_PORT=8000
APP_ENTRYPOINT=telegram
TELEGRAM_BOT_TOKEN=put_your_token_here

# Debug logs API.
API_LOGS_ENABLED=false
API_LOGS_TOKEN=
