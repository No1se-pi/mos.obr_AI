APP_NAME=MosObr AI
APP_ENV=dev
LOG_LEVEL=INFO

# Ollama runs outside the app container by default.
# For Docker Desktop on Windows, host.docker.internal points to the host machine.
OLLAMA_HOST=http://localhost:11434
DOCKER_OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Embedding model for RAG search. First launch can be slow while it downloads.
EMBEDDING_MODEL=BAAI/bge-m3
HF_HUB_DISABLE_XET=1

# PostgreSQL defaults match docker-compose.yml.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mosobr_ai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST_PORT=5432

# Data loaded into the RAG index.
DATA_PATH=./data/colleges.json
FAQ_DATA_PATH=./data/faq_admission.json
WEEEK_KNOWLEDGE_PATH=./data/weeek_knowledge.json
# auto rebuilds RAG documents when source JSON fingerprints change.
BOOTSTRAP_INGEST=auto

# API and Telegram runtime.
API_PORT=8000
APP_ENTRYPOINT=telegram
TELEGRAM_BOT_TOKEN=put_your_token_here

# Public web API endpoint. Keep it in sync with MosobrWidget.init({ apiUrl }).
PUBLIC_CHAT_PATH=/ambi/v1/dialog
PUBLIC_SESSION_CLOSE_PATH=/ambi/v1/session/close
PUBLIC_SESSION_RESET_PATH=/ambi/v1/session/reset
# Set to false on production after all widgets use PUBLIC_CHAT_PATH.
API_LEGACY_CHAT_ENABLED=true
# Comma-separated site origins allowed to call the API. Use your real HTTPS domain in production.
API_CORS_ORIGINS=http://localhost,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:8000
# Enable only when API is behind a trusted reverse proxy that sets X-Forwarded-*.
API_TRUST_PROXY_HEADERS=false
API_RATE_LIMIT_PER_MINUTE=120
API_MAX_BODY_BYTES=16384
API_MAX_MESSAGE_CHARS=4000

# Debug log API is closed by default. Enable only for local/admin use.
API_LOGS_ENABLED=false
API_LOGS_TOKEN=
